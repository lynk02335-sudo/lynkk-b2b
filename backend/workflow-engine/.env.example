# Supabase (required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Server (optional, defaults to 3001)
PORT=3001

# Redis for BullMQ (optional, defaults to localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL for Prisma (required if Prisma is active)
DATABASE_URL=postgresql://user:password@host:5432/lynkk

# CORS origin for production (optional, defaults to allow all)
CORS_ORIGIN=https://your-frontend-domain.com
