# Supabase (required — workflow engine connects to Supabase for DB ops)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Server
PORT=3001

# (Optional) Prisma DATABASE_URL if using a separate Postgres instance
# DATABASE_URL=postgresql://user:password@host:5432/lynkk
