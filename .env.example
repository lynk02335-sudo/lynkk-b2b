# Supabase (required — Vercel frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Workflow engine backend (required — set to your deployed workflow-engine URL)
# Local dev: http://localhost:3001
# Production: https://your-deployed-engine.railway.app (or Render, Fly.io, etc.)
VITE_API_URL=https://your-workflow-engine-url.com
